{
  "manifest_version": 3,
  "name": "itoo Catalog Sync",
  "version": "0.1.0",
  "description": "Imports itoo's products from the FashionGo vendor admin into the itoo catalog.",
  "permissions": ["storage", "scripting", "tabs"],
  "host_permissions": [
    "https://vendoradmin.fashiongo.net/*",
    "http://localhost:3000/*",
    "https://*.workers.dev/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["http://localhost:3000/*", "https://*.workers.dev/*"],
      "js": ["src/catalog-bridge.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "itoo Catalog Sync"
  }
}
