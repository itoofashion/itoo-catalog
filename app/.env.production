# PostHog browser analytics. These are build-time values and they are public by
# nature: the token ships inside the JavaScript bundle to every visitor, so
# committing it here exposes nothing the site does not already serve. Keeping it
# in the repository is what lets any build, local or CI, carry analytics; a
# git-triggered deploy without this file once shipped a bundle with analytics
# silently off.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=phc_CGJHk8vqapUUXskMLuJaU9674fVmNSFj5vo5RbTq4by6
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
