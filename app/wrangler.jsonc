{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "itoo",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-04",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
  // Product photos are downloaded once from FashionGo and kept here, so the
  // catalog serves them from its own domain. Without this binding the worker
  // falls back to memory, which costs one download per photo per instance —
  // see lib/images/store.ts.
  ,"r2_buckets": [{ "binding": "IMAGES", "bucket_name": "itoo-images" }]
  //
  // D1 binding is added in Milestone 2, once the database is provisioned:
  // "d1_databases": [{ "binding": "DB", "database_name": "itoo", "database_id": "..." }]
}
