{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "itoo",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-04",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
  // Product photos are downloaded once from FashionGo and kept here, so the
  // catalog serves them from its own domain. Without this binding the worker
  // falls back to memory, which costs one download per photo per instance
  // (see lib/images/store.ts).
  ,"r2_buckets": [{ "binding": "IMAGES", "bucket_name": "itoo-images" }]
  // Short links and hidden styles live here. Both are small, both have to
  // outlive the isolate that wrote them, and both want a uniqueness guarantee
  // the store cannot give: a link code is only short because the database
  // refuses to hand out the same one twice.
  ,"d1_databases": [
    {
      "binding": "DB",
      "database_name": "itoo",
      "database_id": "f10fdab0-a288-40d8-b899-1e7e4e0053bf"
    }
  ]
}
