{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "itoo",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-04",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
  // Product photos are cached in R2 and served from /i. Uncomment the line
  // below — leading comma and all — once the bucket exists (`wrangler r2 bucket
  // create itoo-images`): a binding to a bucket that has not been created yet
  // fails the deploy. Until then the worker keeps photos in memory instead,
  // which costs one download per photo per instance. See lib/images/store.ts.
  // ,"r2_buckets": [{ "binding": "IMAGES", "bucket_name": "itoo-images" }]
  //
  // D1 binding is added in Milestone 2, once the database is provisioned:
  // "d1_databases": [{ "binding": "DB", "database_name": "itoo", "database_id": "..." }]
}
