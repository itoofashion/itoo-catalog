# Analytics and session replay. Both are read by `next build` and inlined into
# the browser bundle, so they belong in `app/.env.production` (git ignored) or in
# the Worker's build variables, not in the Worker's runtime secrets. A build
# without them runs the app with analytics switched off.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=
